{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "./src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false
  },
  "monorepo": true,
  "root": "./",
  "projects": {
    "backend": {
      "type": "application",
      "root": "./",
      "entryFile": "main",
      "sourceRoot": "./src"
    }
  }
}
