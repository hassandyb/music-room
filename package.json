{
  "name": "music-room",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:types": "npm run dev --workspace=@repo/types",
    "dev": "npm run dev:types & npm run dev:web & npm run dev:api",
    "build": "npm run build --workspaces",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "postinstall": "npm run build --workspace=@repo/types"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/jwt": "^11.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bullmq": "^5.81.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.4"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
